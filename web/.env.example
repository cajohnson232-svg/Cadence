DATABASE_URL="postgresql://postgres@localhost:5433/cadence_web"
# Signs the sign-in cookies. Use a long random value (32 characters or more); the site refuses to
# run in production without one. A hosting blueprint (render.yaml) generates it for you.
SESSION_SECRET="replace-with-a-long-random-string"

# Typed once into the first-time setup page, to prove the site is yours to set up. Always required on a
# real server; on your own machine with "npm run dev" it is only asked for if you set it. 16+ characters.
SETUP_KEY=""

# Optional: Claude reads plain-English rules, backup rules and special-day changes. Without a key a simple
# built-in reader is used instead. Create a key at console.anthropic.com (billed per use).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"

# The scheduling engine: the folder that holds run.py, and the Python that runs it.
# These are the defaults; change them if the engine lives somewhere else.
ENGINE_DIR=".."
ENGINE_PYTHON="python3"
